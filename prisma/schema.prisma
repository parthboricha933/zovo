// ZOVO Ride-Sharing Platform — Database Schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & ROLES
// ============================================================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  name           String
  phone          String?
  phoneVerified  Boolean  @default(false)
  emailVerified  Boolean  @default(false)
  kycStatus      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  driverStatus   String   @default("NONE")    // NONE | PENDING | APPROVED | REJECTED
  avatarUrl      String?
  // activeRole: which dashboard the user is currently using
  activeRole     String   @default("PASSENGER") // PASSENGER | DRIVER | ADMIN
  // admin flag
  isAdmin        Boolean  @default(false)
  // google oauth
  googleId       String?  @unique
  // rating aggregates
  passengerRating Float   @default(5.0)
  driverRating   Float    @default(5.0)
  passengerRides Int      @default(0)
  driverRides    Int      @default(0)
  // status
  isOnline       Boolean  @default(false)
  isBanned       Boolean  @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // relations
  driverProfile  DriverProfile?
  vehicles       Vehicle[]
  passengerProfile PassengerProfile?
  ridesOffered   Ride[]      @relation("RideDriver")
  bookings       Booking[]
  messagesSent   Message[]
  notifications  Notification[]
  payments       Payment[]
  reviewsGiven   Review[]    @relation("ReviewReviewer")
  reviewsReceived Review[]   @relation("ReviewReviewee")
  verifications  Verification[]
  auditLogs      AuditLog[]
  liveLocation   LiveLocation?
}

model DriverProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String
  licenseExpiry   DateTime
  licenseImage    String?
  aadhaarNumber   String?
  aadhaarImage    String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  verifiedAt      DateTime?
  reviewedBy      String?
  rating          Float    @default(5.0)
  totalRides      Int      @default(0)
  totalEarnings   Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Vehicle {
  id              String   @id @default(cuid())
  driverId        String
  driver          User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  make            String
  model           String
  year            Int
  plateNumber     String   @unique
  color           String
  vehicleType     String   @default("SEDAN") // SEDAN | SUV | HATCHBACK | AUTO | BIKE
  totalSeats      Int      @default(4)
  rcImage         String?
  insuranceImage  String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  verifiedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rides           Ride[]
}

model PassengerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating          Float    @default(5.0)
  totalRides      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// RIDES & BOOKINGS
// ============================================================

model Ride {
  id              String   @id @default(cuid())
  driverId        String
  driver          User     @relation("RideDriver", fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  destAddress     String
  destLat         Float
  destLng         Float
  // polyline-encoded route from pickup to dest (for ETA / display)
  routeDistance   Float?   // metres
  routeDuration   Float?   // seconds
  // time
  departureTime   DateTime
  // seats
  totalSeats      Int
  availableSeats  Int
  // price
  pricePerSeat    Float
  // status
  status          String   @default("SCHEDULED") // SCHEDULED | ACTIVE | ONGOING | COMPLETED | CANCELLED
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  // meta
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings        Booking[]
  reviews         Review[]
  // live tracking
  liveLocation    LiveLocation?
}

model Booking {
  id              String   @id @default(cuid())
  rideId          String
  ride            Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passengerId     String
  passenger       User     @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  seatsBooked     Int      @default(1)
  totalPrice      Float
  status          String   @default("REQUESTED") // REQUESTED | CONFIRMED | REJECTED | CANCELLED | STARTED | COMPLETED
  // OTP
  otpCode         String?
  otpVerifiedAt   DateTime?
  // timestamps
  requestedAt     DateTime @default(now())
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  cancelledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  // chat archived flag
  chatArchived    Boolean  @default(false)
  // payment
  paymentMethod   String   @default("CASH") // CASH | UPI | RAZORPAY | STRIPE
  paymentStatus   String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED

  messages        Message[]
  payments        Payment[]
  reviews         Review[]
}

// ============================================================
// REAL-TIME / CHAT / OTP / NOTIFICATIONS
// ============================================================

model Message {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content         String
  readAt          DateTime?
  createdAt       DateTime @default(now())
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // BOOKING_REQUEST | BOOKING_ACCEPTED | BOOKING_REJECTED | DRIVER_ARRIVED | OTP_GENERATED | RIDE_STARTED | RIDE_COMPLETED | VERIFICATION_APPROVED | CHAT_MESSAGE | SYSTEM
  title           String
  body            String
  dataJson        String?
  readAt          DateTime?
  createdAt       DateTime @default(now())
}

// ============================================================
// PAYMENTS & REVIEWS
// ============================================================

model Payment {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  method          String   @default("CASH")
  status          String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  transactionId   String?
  platformFee     Float    @default(0)
  driverPayout    Float    @default(0)
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rideId          String
  ride            Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        User     @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId      String
  reviewee        User     @relation("ReviewReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating          Int      // 1-5
  comment         String?
  createdAt       DateTime @default(now())

  @@unique([bookingId, reviewerId])
}

// ============================================================
// VERIFICATION & AUDIT
// ============================================================

model Verification {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // EMAIL | PHONE | KYC | DRIVER | VEHICLE
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  documentUrl     String?
  notes           String?
  reviewedBy      String?
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?

  @@unique([userId, type])
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action          String
  details         String?
  ip              String?
  createdAt       DateTime @default(now())
}

// ============================================================
// LIVE TRACKING
// ============================================================

model LiveLocation {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rideId          String?  @unique
  ride            Ride?    @relation(fields: [rideId], references: [id], onDelete: Cascade)
  lat             Float
  lng             Float
  heading         Float?
  speed           Float?
  updatedAt       DateTime @updatedAt
}
