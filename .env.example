# Database — PostgreSQL (Neon or any hosted Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# JWT secret (generate a long random string)
JWT_SECRET="your-long-random-jwt-secret"

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Google OAuth (server-side verification)
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Email (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="ZOVO <your-email@gmail.com>"

# Public URL (used for email verification links)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Realtime service URL (used by API routes to push events to socket.io server)
REALTIME_BASE_URL="http://localhost:3003"
NEXT_PUBLIC_REALTIME_BASE_URL=""

# Auto-approve verifications (Phone, KYC, Driver, Vehicle) on submission
# Default: "1" in dev, "0" in production. Set to "1" to skip admin review.
AUTO_APPROVE_VERIFICATIONS="1"
